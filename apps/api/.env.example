DATABASE_URL="file:./dev.db"
PORT=4000

# Money provider: "mock" (default) or "sandbox"
BMONI_PROVIDER=mock

# BMONI sandbox. Paths already include /v1 — do NOT append it to the base URL.
# Auth is sent as the header  x-api-key: <BMONI_API_KEY>  (server-side only).
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=
# Sandbox test values: BVN=22222222222, country=NGA. Never use real identity docs.

# Gemini (AI layer)
GEMINI_API_KEY=

# 32-byte hex secret for JWT + owner-key encryption
APP_SECRET=
